---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sobre" description="Sobre Pedro Xavier.">
  <section class="container prose page-copy">
    <p class="eyebrow">Sobre</p>
    <h1>Pedro Xavier</h1>
    <p>
      Sou engenheiro de software e escrevo para registrar decisoes tecnicas,
      arquitetura, experimentos com IA e o tipo de aprendizado que normalmente se
      perde em conversas e pull requests.
    </p>
    <p>
      Esta pagina foi deixada propositalmente simples para que o texto possa ser
      editado diretamente em <code>src/pages/about.astro</code>.
    </p>
  </section>
</BaseLayout>

